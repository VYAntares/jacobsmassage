# Local: copy the first three lines to .dev.vars (used by `npm run preview`).
# Production: set them in Cloudflare → Settings → Variables and Secrets.
# Contact form delivery (optional). Without these, the form clearly tells
# visitors that sending is unavailable and points them to the phone number.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Jacob's Massage <site@votre-domaine.ch>"

# Build variable: public site URL used for canonical links, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://www.jacobsmassage.ch
